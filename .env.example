# Copy to apps/api/.env (never commit real secrets)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
PORT=3010
JWT_SECRET="replace-with-long-random-string-min-16"
TOTP_ENCRYPTION_KEY="replace-with-different-long-random-string"
# Optional alias for Epic private-key encryption (falls back to TOTP_ENCRYPTION_KEY)
# EPIC_ENCRYPTION_KEY="replace-with-another-long-random-string"
WEB_ORIGIN="http://localhost:5173"
# NODE_ENV=production
# STRICT_SECRETS=1
# Comma-separated extra Epic/FHIR host suffixes for non-sandbox customers
# EPIC_ALLOWED_HOSTS=myhospital.org
