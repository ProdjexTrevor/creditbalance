    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.9",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "otplib": "^13.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
